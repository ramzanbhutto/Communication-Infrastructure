{
  "name": "covent-ops-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost --port 4173",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.html *.json",
    "format:check": "prettier --check src tests *.ts *.html *.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "get-nonce": "^1.0.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.8.2",
    "typescript": "~5.9.3",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
